<alertModel version="4.6.0">
  <id>6f1c3a52-0f5e-4c1e-9a8b-0c0de0a1e7a1</id>
  <name>Connector errors (all channels)</name>
  <enabled>true</enabled>
  <!-- Every source and destination connector error, on every channel deployed now or
       later (newChannelSource/newChannelDestination with nothing listed), except the
       Alert inbox it writes to. -->
  <trigger class="defaultTrigger" version="4.6.0">
    <alertChannels version="4.6.0">
      <newChannelSource>true</newChannelSource>
      <newChannelDestination>true</newChannelDestination>
      <enabledChannels/>
      <disabledChannels>
        <string>a1e7b0c5-3d4e-4f60-9a1b-2c3d4e5f6a70</string>
      </disabledChannels>
      <partialChannels/>
    </alertChannels>
    <errorEventTypes>
      <errorEventType>SOURCE_CONNECTOR</errorEventType>
      <errorEventType>DESTINATION_CONNECTOR</errorEventType>
    </errorEventTypes>
    <regex></regex>
  </trigger>
  <!-- No email: the engine counts an alert as alerted only when it has an action, so
       the action sends it to the Alert inbox channel instead. -->
  <actionGroups>
    <alertActionGroup version="4.6.0">
      <actions>
        <alertAction version="4.6.0">
          <protocol>Channel</protocol>
          <recipient>a1e7b0c5-3d4e-4f60-9a1b-2c3d4e5f6a70</recipient>
        </alertAction>
      </actions>
      <subject>${channelName}: ${errorType}</subject>
      <template>${errorType} on ${channelName} / ${connectorName}
Message: ${messageId}
${errorMessage}

${error}</template>
    </alertActionGroup>
  </actionGroups>
  <properties/>
</alertModel>
