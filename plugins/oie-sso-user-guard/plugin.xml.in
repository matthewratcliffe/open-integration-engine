<pluginMetaData path="ssouserguard">
    <name>SSO User Guard</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!--
      Exact string match against the server version, split on commas. An
      extension declaring anything else is refused outright by ExtensionLoader
      and silently not loaded, so build.sh stamps this from MIRTH_VERSION.
    -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Renders the web administrator's Edit User dialog read-only for accounts bound to an OIDC identity provider, which owns their username, name, email and organization and rewrites them on every sign-in. Console UI only: no server classes, no libraries, no API of its own.</description>

    <!--
      Deliberately empty of code. This extension exists to carry a webadmin/
      folder, which is how the web console discovers a plugin UI, and it loads
      nothing into the engine's JVM: no serverClasses, no library, no
      apiProvider. The engine registers it as an installed extension and the Web
      Support plugin serves its console half; nothing else happens server-side.
    -->
</pluginMetaData>
