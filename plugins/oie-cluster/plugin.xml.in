<pluginMetaData path="cluster">
    <name>Cluster</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!--
      Exact string match against the server version, split on commas. An
      extension declaring anything else is refused outright by ExtensionLoader
      and silently not loaded, so build.sh stamps this from MIRTH_VERSION.
    -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Runs several engines against one database as one cluster: a deploy made on any node is applied on all of them, channels can be placed on every node or on exactly one, and the console shows every node, what each has deployed, and the message counts summed across them. Convergence is off until OIE_CLUSTER_ENABLED is set.</description>

    <!--
      Two classes, deliberately. DefaultExtensionController tests each loaded
      server class against every plugin interface and adds it to the list it
      later calls start() on once per interface it implements. A single class
      implementing both ServicePlugin and ChannelPlugin therefore has its whole
      lifecycle run twice.
    -->
    <serverClasses>
        <string>org.openintegrationengine.plugins.cluster.ClusterServicePlugin</string>
        <string>org.openintegrationengine.plugins.cluster.ClusterChannelPlugin</string>
    </serverClasses>

    <library type="SERVER" path="libs/cluster-server.jar" />

    <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.plugins.cluster.ClusterServletInterface" />
    <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.plugins.cluster.ClusterServlet" />
</pluginMetaData>
