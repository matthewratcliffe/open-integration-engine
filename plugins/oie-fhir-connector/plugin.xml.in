<pluginMetaData path="fhir">
    <name>FHIR Connector Service Plugin</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Required for correct use of the FHIR connectors: registers their properties classes with the engine's XStream allowlist at server start, without which every channel using them would deserialise as an invalid channel.</description>

    <serverClasses>
        <string>org.openintegrationengine.connectors.fhir.server.FhirConnectorServicePlugin</string>
    </serverClasses>

    <library type="SERVER" path="fhir-server.jar" />
    <library type="SHARED" path="fhir-shared.jar" />
</pluginMetaData>
