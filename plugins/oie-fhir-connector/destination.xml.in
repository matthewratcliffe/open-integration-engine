<connectorMetaData path="fhir">
    <name>FHIR Sender</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Performs one FHIR R4 or R5 RESTful interaction against a remote FHIR server per message: create, update, patch, read, vread, search, delete, history, transaction or $operation. The response body becomes the destination's response; the status line, headers, Location, ETag and the id the server assigned go into the connector map.</description>

    <clientClassName>org.openintegrationengine.connectors.fhir.client.FhirSender</clientClassName>
    <serverClassName>org.openintegrationengine.connectors.fhir.server.FhirDispatcher</serverClassName>
    <sharedClassName>org.openintegrationengine.connectors.fhir.FhirDispatcherProperties</sharedClassName>

    <library type="CLIENT" path="fhir-client.jar" />
    <library type="SHARED" path="fhir-shared.jar" />
    <library type="SERVER" path="fhir-server.jar" />

    <protocol>fhir</protocol>
    <type>DESTINATION</type>
</connectorMetaData>
