<pluginMetaData path="sftp">
    <name>SFTP Connector</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!--
      Exact string match against the server version, split on commas. build.sh
      stamps this from MIRTH_VERSION.
    -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Registers the SFTP connectors' classes with the channel serializer. XStream refuses any class outside its allow list, which covers com.mirth.connect only, so without this the engine stores every channel using these connectors as an invalid channel while reporting a successful save. Ships alongside source.xml and destination.xml in the same extension.</description>

    <serverClasses>
        <string>org.openintegrationengine.connectors.sftp.server.SftpSerializerPlugin</string>
    </serverClasses>
    <clientClasses>
        <string>org.openintegrationengine.connectors.sftp.client.SftpSerializerClientPlugin</string>
    </clientClasses>

    <library type="SHARED" path="sftp-shared.jar" />
    <library type="SERVER" path="sftp-server.jar" />
    <library type="CLIENT" path="sftp-client.jar" />
</pluginMetaData>
