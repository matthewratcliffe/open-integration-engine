<connectorMetaData path="sftp">
    <name>SFTP Sender</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!-- See the note in source.xml: this has to match the server version exactly. -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Writes each message to a remote SFTP server as a file. Authenticates with a password, a private key with an optional passphrase, or both, and verifies the server's host key against a known_hosts file or a pinned key. Writes through a temporary name and renames on completion so the far end never sees a partial file.</description>

    <clientClassName>org.openintegrationengine.connectors.sftp.client.SftpSenderPanel</clientClassName>
    <serverClassName>org.openintegrationengine.connectors.sftp.server.SftpDispatcher</serverClassName>
    <sharedClassName>org.openintegrationengine.connectors.sftp.SftpDispatcherProperties</sharedClassName>

    <library type="CLIENT" path="sftp-client.jar" />
    <library type="SHARED" path="sftp-shared.jar" />
    <library type="SERVER" path="sftp-server.jar" />

    <!--
      Declared again because each connectorMetaData file carries its own library
      list, and a channel may use the sender without the listener. They resolve to
      the same files in the same extension directory, so nothing is loaded twice.
    -->
    <library type="SERVER" path="lib/sshd-common-@SSHD_VERSION@.jar" />
    <library type="SERVER" path="lib/sshd-core-@SSHD_VERSION@.jar" />
    <library type="SERVER" path="lib/sshd-sftp-@SSHD_VERSION@.jar" />

    <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.connectors.sftp.SftpConnectorServletInterface" />
    <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.connectors.sftp.server.SftpConnectorServlet" />

    <protocol>sftp</protocol>
    <type>DESTINATION</type>
</connectorMetaData>
