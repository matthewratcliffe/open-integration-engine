<connectorMetaData path="sftp">
    <name>SFTP Listener</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!--
      Exact string match against the server version, split on commas. A connector
      declaring anything else is refused outright by ExtensionLoader and silently
      not loaded — and then every channel using it is stored as an invalid
      channel while the API still reports a successful save. build.sh stamps this
      from MIRTH_VERSION.
    -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Receives files over SFTP, in either direction. In push mode the engine runs an SFTP server that partners connect to and upload into, with per-account passwords and public keys; in pull mode it polls a remote SFTP server on a schedule, authenticating with a password, a private key, or both, and verifying the server's host key.</description>

    <!--
      The name in the channel XML is matched against ConnectorProperties.getName(),
      and the class named here is what the engine instantiates for it. Both must
      agree with SftpReceiverProperties.getName().
    -->
    <clientClassName>org.openintegrationengine.connectors.sftp.client.SftpListenerPanel</clientClassName>
    <serverClassName>org.openintegrationengine.connectors.sftp.server.SftpReceiver</serverClassName>
    <sharedClassName>org.openintegrationengine.connectors.sftp.SftpReceiverProperties</sharedClassName>

    <library type="CLIENT" path="sftp-client.jar" />
    <library type="SHARED" path="sftp-shared.jar" />
    <library type="SERVER" path="sftp-server.jar" />

    <!--
      Apache MINA SSHD, which is the SFTP server in push mode. Server-side only:
      the Swing panel and the shared properties have no dependency on it, and the
      client half of this connector uses the engine's own jsch.
    -->
    <library type="SERVER" path="lib/sshd-common-@SSHD_VERSION@.jar" />
    <library type="SERVER" path="lib/sshd-core-@SSHD_VERSION@.jar" />
    <library type="SERVER" path="lib/sshd-sftp-@SSHD_VERSION@.jar" />

    <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.connectors.sftp.SftpConnectorServletInterface" />
    <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.connectors.sftp.server.SftpConnectorServlet" />

    <protocol>sftp</protocol>
    <type>SOURCE</type>
</connectorMetaData>
