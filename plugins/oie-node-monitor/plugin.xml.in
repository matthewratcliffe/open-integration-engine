<pluginMetaData path="nodemonitor">
    <name>Node Monitor</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!--
      Exact string match against the server version, split on commas. An
      extension declaring anything else is refused outright by ExtensionLoader
      and silently not loaded, so build.sh stamps this from MIRTH_VERSION.
    -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Shows every engine at once: online or offline, uptime, CPU, heap, disk per volume, threads, deployed and running channels, queued messages, and message volume with rates and an hour of history. Each node samples itself into the shared database, so any node's console answers for all of them.</description>

    <serverClasses>
        <string>org.openintegrationengine.plugins.nodemonitor.NodeMonitorServicePlugin</string>
    </serverClasses>

    <library type="SERVER" path="libs/nodemonitor-server.jar" />

    <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.plugins.nodemonitor.NodeMonitorServletInterface" />
    <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.plugins.nodemonitor.NodeMonitorServlet" />
</pluginMetaData>
