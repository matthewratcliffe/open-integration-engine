<connectorMetaData path="nullsender">
    <name>Null Sender</name>
    <author>This repository</author>
    <pluginVersion>@PLUGIN_VERSION@</pluginVersion>
    <!-- See the note in plugin.xml: this has to match the server version exactly. -->
    <mirthVersion>@MIRTH_VERSION@</mirthVersion>
    <url>https://openintegrationengine.org</url>
    <description>Discards every message and delivers nowhere. The message is still recorded and counted exactly as it would be for a destination that delivered it, and the connector returns a configurable acknowledgement -- an HL7 v2 ACK built from the inbound message, a template, or nothing -- so a channel can answer its sender without anything downstream existing yet.</description>

    <!--
      The name above is matched against NullDispatcherProperties.getName(), and the classes
      named here are what the engine and the Administrator instantiate for it. All three
      have to agree.
    -->
    <clientClassName>org.openintegrationengine.connectors.nullsender.client.NullSenderPanel</clientClassName>
    <serverClassName>org.openintegrationengine.connectors.nullsender.server.NullDispatcher</serverClassName>
    <sharedClassName>org.openintegrationengine.connectors.nullsender.NullDispatcherProperties</sharedClassName>

    <library type="CLIENT" path="nullsender-client.jar" />
    <library type="SHARED" path="nullsender-shared.jar" />
    <library type="SERVER" path="nullsender-server.jar" />

    <protocol>NULL</protocol>
    <type>DESTINATION</type>
</connectorMetaData>
